---
import { t } from '../i18n';
import { company } from '../data/site';
---
<footer class="border-t border-white/10 bg-slate-950/60">
  <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 text-sm md:grid-cols-2">
    <div>
      <p class="font-display text-lg font-bold text-white">Helpo<span class="grad">Bot247</span></p>
      <p class="mt-2" data-i18n="footer.tagline">{t('footer.tagline')}</p>
      <p class="mt-4 text-slate-400">{company.legalName}<br /><span data-i18n="footer.ico">{t('footer.ico')}</span>: {company.ico}<br /><a class="hover:text-white" href={`mailto:${company.email}`}>{company.email}</a></p>
    </div>
    <div class="text-xs leading-relaxed text-slate-500">
      <p data-i18n="footer.gdpr">{t('footer.gdpr')}</p>
      <a class="mt-2 inline-block text-neon-soft hover:underline" href={company.privacyUrl} data-i18n="footer.privacy">{t('footer.privacy')}</a>
    </div>
  </div>
  <p class="border-t border-white/5 py-5 text-center text-xs text-slate-500">© {new Date().getFullYear()} HelpoBot247 · <span data-i18n="footer.rights">{t('footer.rights')}</span></p>
</footer>
