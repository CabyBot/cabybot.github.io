---
import { t } from '../i18n';
import { company } from '../data/site';
const field = 'w-full rounded-xl border border-white/10 bg-slate-900/70 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-neon focus:outline-none';
---
<section id="contact" class="relative">
  <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 mx-auto h-64 max-w-xl rounded-full bg-neon/15 blur-[100px]"></div>
  <div class="section relative max-w-2xl">
    <div class="text-center">
      <h2 class="h2" data-i18n="contact.title">{t('contact.title')}</h2>
      <p class="mt-3" data-i18n="contact.subtitle">{t('contact.subtitle')}</p>
    </div>
    <form action={company.formAction} method="POST" class="glass mt-10 space-y-4 p-6 sm:p-8">
      <input type="text" name="name" required autocomplete="name" aria-label="Name" data-i18n-ph="contact.name" placeholder={t('contact.name')} class={field} />
      <div class="grid gap-4 sm:grid-cols-2">
        <input type="tel" name="phone" required autocomplete="tel" aria-label="Phone" data-i18n-ph="contact.phone" placeholder={t('contact.phone')} class={field} />
        <input type="email" name="email" required autocomplete="email" aria-label="Email" data-i18n-ph="contact.email" placeholder={t('contact.email')} class={field} />
      </div>
      <label class="flex items-start gap-3 text-xs leading-relaxed">
        <input type="checkbox" name="gdpr" required class="mt-0.5 h-4 w-4 accent-purple-500" />
        <span data-i18n="contact.gdpr">{t('contact.gdpr')}</span>
      </label>
      <button type="submit" class="btn-primary w-full" data-i18n="contact.submit">{t('contact.submit')}</button>
    </form>
  </div>
</section>
