---
import { t } from '../i18n';
import { prices, planKeys } from '../data/site';
---
<section id="pricing" class="section">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="h2" data-i18n="pricing.title">{t('pricing.title')}</h2>
    <p class="mt-3" data-i18n="pricing.subtitle">{t('pricing.subtitle')}</p>
  </div>

  <div class="mt-8 flex justify-center">
    <div class="inline-flex rounded-xl border border-white/10 bg-slate-800 p-1 text-sm font-semibold" role="group">
      {[1, 2, 3].map((n) => (
        <button type="button" data-plang={n} aria-pressed={n === 1} data-i18n={`pricing.l${n}`}
          class="rounded-lg px-4 py-2 transition aria-pressed:bg-gradient-to-r aria-pressed:from-neon aria-pressed:to-indigo-500 aria-pressed:text-white hover:text-white">{t(`pricing.l${n}`)}</button>
      ))}
    </div>
  </div>

  <div class="mt-10 grid gap-6 lg:grid-cols-3">
    {planKeys.map((key, i) => {
      const popular = key === 'pro';
      return (
        <article class={`relative flex flex-col rounded-2xl p-7 ${popular ? 'border-2 border-neon bg-slate-800 shadow-neon lg:-translate-y-3' : 'glass'}`}>
          {popular && <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-neon px-3 py-1 text-xs font-semibold text-white" data-i18n="pricing.popular">{t('pricing.popular')}</span>}
          <h3 class="font-display text-xl font-bold text-white">{t(`pricing.plans.${i}.name`)}</h3>
          <p class="mt-1 text-sm" data-i18n={`pricing.plans.${i}.desc`}>{t(`pricing.plans.${i}.desc`)}</p>
          <p class="mt-6 flex items-baseline gap-2">
            <span class="font-display text-4xl font-bold text-white" data-prices={JSON.stringify(prices[key])}>{prices[key][0]} Kč</span>
            <span class="text-sm" data-i18n="pricing.month">{t('pricing.month')}</span>
          </p>
          <ul class="mt-6 flex-1 space-y-3 text-sm">
            {[0, 1, 2, 3].map((f) => (
              <li class="flex gap-3">
                <svg viewBox="0 0 24 24" class="mt-0.5 h-4 w-4 shrink-0 text-neon-soft" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
                <span data-i18n={`pricing.plans.${i}.features.${f}`}>{t(`pricing.plans.${i}.features.${f}`)}</span>
              </li>
            ))}
          </ul>
          <a href="#contact" class={`mt-8 ${popular ? 'btn-primary' : 'btn-ghost'}`} data-i18n="pricing.cta">{t('pricing.cta')}</a>
        </article>
      );
    })}
  </div>
</section>
