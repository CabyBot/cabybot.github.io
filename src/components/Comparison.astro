---
import { t } from '../i18n';
---
<section id="compare" class="section">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="h2" data-i18n="compare.title">{t('compare.title')}</h2>
    <p class="mt-3" data-i18n="compare.subtitle">{t('compare.subtitle')}</p>
  </div>
  <div class="glass mt-10 overflow-x-auto">
    <table class="w-full min-w-[34rem] text-left text-sm">
      <thead>
        <tr class="border-b border-white/10 text-white">
          <th class="p-4 font-medium text-slate-400" data-i18n="compare.criteria">{t('compare.criteria')}</th>
          <th class="p-4 font-semibold" data-i18n="compare.human">{t('compare.human')}</th>
          <th class="bg-neon/10 p-4 font-semibold text-neon-soft" data-i18n="compare.bot">{t('compare.bot')}</th>
        </tr>
      </thead>
      <tbody>
        {[0, 1, 2, 3, 4].map((i) => (
          <tr class="border-b border-white/5 last:border-0">
            <th scope="row" class="p-4 font-medium text-white" data-i18n={`compare.rows.${i}.label`}>{t(`compare.rows.${i}.label`)}</th>
            <td class={`p-4 ${i === 0 ? 'text-base font-semibold text-slate-200' : ''}`} data-i18n={`compare.rows.${i}.human`}>{t(`compare.rows.${i}.human`)}</td>
            <td class={`bg-neon/10 p-4 text-white ${i === 0 ? 'text-base font-bold' : ''}`} data-i18n={`compare.rows.${i}.bot`}>{t(`compare.rows.${i}.bot`)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-6 text-center font-display text-xl font-bold grad" data-i18n="compare.saving">{t('compare.saving')}</p>
</section>
