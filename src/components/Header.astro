---
import { t } from '../i18n';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = ['features', 'pricing', 'compare', 'contact'];
const langs = [['cs', 'CS'], ['vn', 'VN'], ['en', 'EN']];
---
<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-900/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
    <a href="#top" class="flex items-center gap-2.5 font-display text-lg font-bold text-white">
      <img src={`${base}/logo-header.jpg`} alt="HelpoBot247" width="40" height="40" class="h-10 w-10 rounded-xl object-cover ring-1 ring-white/20" />
      <span>Helpo<span class="grad">Bot247</span></span>
    </a>

    <nav class="hidden items-center gap-7 text-sm md:flex" aria-label="Main">
      {links.map((k) => <a class="transition hover:text-white" href={`#${k}`} data-i18n={`nav.${k}`}>{t(`nav.${k}`)}</a>)}
    </nav>

    <div class="flex items-center gap-3">
      <div class="flex rounded-lg border border-white/10 bg-slate-800 p-0.5 text-xs font-semibold" role="group" aria-label="Language">
        {langs.map(([code, label]) => (
          <button type="button" data-lang-btn={code} aria-pressed={code === 'cs'}
            class="rounded-md px-2.5 py-1.5 transition aria-pressed:bg-neon aria-pressed:text-white hover:text-white">{label}</button>
        ))}
      </div>
      <button id="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu" class="grid h-9 w-9 place-items-center rounded-lg border border-white/10 md:hidden">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="hidden border-t border-white/10 bg-slate-900 px-5 py-3 md:hidden" aria-label="Mobile">
    {links.map((k) => <a class="block py-2.5 text-sm" href={`#${k}`} data-i18n={`nav.${k}`}>{t(`nav.${k}`)}</a>)}
  </nav>
</header>
