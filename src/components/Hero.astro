---
import { t } from '../i18n';
---
<section id="top" class="relative overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute -top-40 left-1/2 h-[28rem] w-[46rem] -translate-x-1/2 rounded-full bg-neon/25 blur-[120px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute right-0 top-40 h-72 w-72 rounded-full bg-indigo-500/20 blur-[100px]"></div>
  <div class="relative mx-auto max-w-4xl px-5 pb-24 pt-20 text-center sm:pt-28">
    <span class="inline-flex items-center gap-2 rounded-full border border-neon/40 bg-neon/10 px-4 py-1.5 text-xs font-medium text-neon-soft">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-neon-soft"></span>
      <span data-i18n="hero.badge">{t('hero.badge')}</span>
    </span>
    <h1 class="mt-6 font-display text-4xl font-bold leading-tight tracking-tight text-white sm:text-6xl" data-i18n-html="hero.title" set:html={t('hero.title')} />
    <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed sm:text-lg" data-i18n="hero.subtitle">{t('hero.subtitle')}</p>
    <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="#contact" class="btn-primary" data-i18n="hero.cta1">{t('hero.cta1')}</a>
      <a href="#pricing" class="btn-ghost" data-i18n="hero.cta2">{t('hero.cta2')}</a>
    </div>
    <p class="mt-6 text-xs text-slate-500" data-i18n="hero.note">{t('hero.note')}</p>
  </div>
</section>
