---
import { t } from '../i18n';
const icons = [
  'M12 6v6l4 2m6-2a10 10 0 11-20 0 10 10 0 0120 0z',
  'M12 21a9 9 0 100-18 9 9 0 000 18zM3.6 9h16.8M3.6 15h16.8M12 3a14 14 0 010 18M12 3a14 14 0 000 18',
  'M8.7 10.7l6.6-3.4M8.7 13.3l6.6 3.4M18 8a3 3 0 100-6 3 3 0 000 6zM6 15a3 3 0 100-6 3 3 0 000 6zM18 22a3 3 0 100-6 3 3 0 000 6z',
  'M8 7V3m8 4V3M4 11h16M5 5h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V6a1 1 0 011-1z',
];
---
<section id="features" class="section">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="h2" data-i18n="features.title">{t('features.title')}</h2>
    <p class="mt-3" data-i18n="features.subtitle">{t('features.subtitle')}</p>
  </div>
  <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {icons.map((d, i) => (
      <article class="glass p-6">
        <span class="grid h-11 w-11 place-items-center rounded-xl bg-neon/15 text-neon-soft">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={d} /></svg>
        </span>
        <h3 class="mt-5 font-display text-lg font-bold text-white" data-i18n={`features.items.${i}.title`}>{t(`features.items.${i}.title`)}</h3>
        <p class="mt-2 text-sm leading-relaxed" data-i18n={`features.items.${i}.text`}>{t(`features.items.${i}.text`)}</p>
      </article>
    ))}
  </div>
</section>
