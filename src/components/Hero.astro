---
import { t } from '../i18n';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section id="top" class="relative overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none absolute -top-40 left-1/2 h-[28rem] w-[46rem] -translate-x-1/2 rounded-full bg-neon/25 blur-[120px]"></div>
  <div aria-hidden="true" class="pointer-events-none absolute right-0 top-40 h-72 w-72 rounded-full bg-indigo-500/20 blur-[100px]"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-5 pb-20 pt-16 sm:pt-24 lg:grid-cols-[1.15fr_1fr]">
    <div class="text-center lg:text-left">
      <span class="inline-flex items-center gap-2 rounded-full border border-neon/40 bg-neon/10 px-4 py-1.5 text-xs font-medium text-neon-soft">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-neon-soft"></span>
        <span data-i18n="hero.badge">{t('hero.badge')}</span>
      </span>
      <h1 class="mt-6 font-display text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl xl:text-6xl" data-i18n-html="hero.title" set:html={t('hero.title')} />
      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed sm:text-lg lg:mx-0" data-i18n="hero.subtitle">{t('hero.subtitle')}</p>
      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row lg:justify-start">
        <a href="#contact" class="btn-primary" data-i18n="hero.cta1">{t('hero.cta1')}</a>
        <a href="#pricing" class="btn-ghost" data-i18n="hero.cta2">{t('hero.cta2')}</a>
      </div>
      <p class="mt-6 text-xs text-slate-500" data-i18n="hero.note">{t('hero.note')}</p>
    </div>

    <div class="relative mx-auto w-64 sm:w-80 lg:w-full lg:max-w-md">
      <div aria-hidden="true" class="absolute inset-6 rounded-full bg-gradient-to-br from-neon/40 to-cyan-400/20 blur-3xl"></div>
      <img src={`${base}/mascot.png`} alt="CabyBot mascot" width="500" height="500" fetchpriority="high"
        class="relative w-full drop-shadow-[0_20px_40px_rgba(168,85,247,.35)]" />
    </div>
  </div>
</section>
